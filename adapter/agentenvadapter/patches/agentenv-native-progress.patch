+//! Errors at the native volume catalog boundary, independent of VM snapshots.
+use anyhow::Error as AnyhowError;
+use thiserror::Error;
+
+pub type CatalogResult<T> = Result<T, CatalogError>;
+
+#[derive(Debug, Error)]
+pub enum CatalogError {
+    #[error("invalid repository request: {reason}")]
+    InvalidRequest { reason: String },
+    #[error("volume not found: {lookup}")]
+    VolumeNotFound { lookup: String },
+    #[error("volume name already exists: {name}")]
+    VolumeNameConflict { name: String },
+    #[error("unsupported operation: {feature}")]
+    Unsupported { feature: String },
+    #[error("backend error: {message}")]
+    Backend {
+        message: String,
+        #[source]
+        source: Option<AnyhowError>,
+    },
+}
+
+impl CatalogError {
+    pub fn backend(message: impl Into<String>, source: impl Into<AnyhowError>) -> Self {
+        Self::Backend {
+            message: message.into(),
+            source: Some(source.into()),
+        }
+    }
+}
diff --git a/storage/volume-core/src/compact.rs b/storage/volume-core/src/compact.rs
new file mode 100644
index 0000000..b64d9c4
--- /dev/null
+++ b/storage/volume-core/src/compact.rs
@@ -0,0 +1,113 @@
+//! Native layer compaction shared by volume publication and runtime capture.
+use anyhow::{Context, Result};
+use overlaybd::{
+    backend::local::LocalFile,
+    config::LayerConfig,
+    index_file::{merge_files_ro, CommitArgs},
+    virtual_file::VirtualFile,
+    zfile::{CompressArgs, CompressOptions, ZFileCompactWriter},
+};
+use std::{
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+use tracing::debug;
+use uuid::Uuid;
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CompressionAlgorithm {
+    Lz4,
+    Zstd,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CompactOutput {
+    Raw,
+    ZFile {
+        algorithm: CompressionAlgorithm,
+        workers: usize,
+    },
+}
+pub async fn create_commit_args(
+    output: Arc<dyn VirtualFile>,
+    mode: CompactOutput,
+    concurrency: usize,
+) -> Result<CommitArgs> {
+    let mut args = match mode {
+        CompactOutput::Raw => CommitArgs::new(output),
+        CompactOutput::ZFile { algorithm, workers } => {
+            let algorithm = match algorithm {
+                CompressionAlgorithm::Lz4 => CompressOptions::LZ4,
+                CompressionAlgorithm::Zstd => CompressOptions::ZSTD,
+            };
+            let mut compress_args = CompressArgs::new(CompressOptions::new(
+                algorithm,
+                CompressOptions::DEFAULT_BLOCK_SIZE,
+                0,
+            ));
+            compress_args.workers = workers.max(1);
+            CommitArgs::from_writer(Arc::new(
+                ZFileCompactWriter::new(output, &compress_args).await?,
+            ))
+        }
+    };
+    args.concurrency = concurrency;
+    Ok(args)
+}
+pub async fn compact_layers(
+    layers: &[LayerConfig],
+    output_path: &Path,
+    mode: CompactOutput,
+) -> Result<Option<PathBuf>> {
+    if layers.is_empty() {
+        return Ok(None);
+    }
+
+    let mut src_files: Vec<Arc<dyn VirtualFile>> = Vec::with_capacity(layers.len());
+    for layer in layers {
+        let path = Path::new(&layer.file);
+        let local: Arc<dyn VirtualFile> = Arc::new(
+            LocalFile::open_ro(path)
+                .with_context(|| format!("open layer for compaction: {}", path.display()))?,
+        );
+        let tar_adapted = overlaybd::backend::tar::new_tar_file_adaptor(local)
+            .await
+            .with_context(|| format!("adapt layer as tar file: {}", path.display()))?;
+        let display = path.display().to_string();
+        let switched =
+            overlaybd::backend::switch::new_switch_file(tar_adapted, true, Some(&display))
+                .await
+                .with_context(|| format!("open layer via switch file: {}", path.display()))?;
+        src_files.push(switched);
+    }
+
+    let lower_tmp = output_path.with_extension(format!("commit.{}.tmp", Uuid::now_v7()));
+    let build_result: Result<()> = async {
+        let output_file: Arc<dyn VirtualFile> =
+            Arc::new(LocalFile::new(&lower_tmp).context("create compacted layer output file")?);
+        let commit_args = create_commit_args(output_file, mode, 32).await?;
+        merge_files_ro(&src_files, commit_args)
+            .await
+            .context("merge layers")?;
+        tokio::fs::rename(&lower_tmp, output_path)
+            .await
+            .with_context(|| {
+                format!(
+                    "publish compacted layer to {} failed",
+                    output_path.display()
+                )
+            })?;
+        Ok(())
+    }
+    .await;
+
+    if build_result.is_err() {
+        let _ = tokio::fs::remove_file(&lower_tmp).await;
+    }
+    build_result?;
+
+    debug!(
+        output = %output_path.display(),
+        input_layers = layers.len(),
+        "compacted overlaybd layers"
+    );
+    Ok(Some(output_path.to_path_buf()))
+}
diff --git a/storage/volume-core/src/content.rs b/storage/volume-core/src/content.rs
new file mode 100644
index 0000000..e60a063
--- /dev/null
+++ b/storage/volume-core/src/content.rs
@@ -0,0 +1,161 @@
+//! Original VolumeManager backing algorithms, shared by native and CSI callers.
+use crate::{VolumeError, BYTES_PER_MB};
+use overlaybd::config::{ImageConfig, LayerConfig};
+use std::path::{Path, PathBuf};
+use tokio::process::Command;
+
+pub async fn create_empty_backing(directory: &Path, size_mb: u64) -> Result<PathBuf, VolumeError> {
+    create_empty_backing_inner(directory, size_mb, None).await
+}
+
+/// CSI callers allocate and persist the filesystem UUID before formatting.
+/// A pre-existing working directory is never adopted or reformatted by this
+/// entrypoint; unknown operations must inspect their original journal first.
+pub async fn create_identified_empty_backing(
+    directory: &Path,
+    size_mb: u64,
+    filesystem_uuid: &str,
+) -> Result<PathBuf, VolumeError> {
+    uuid::Uuid::parse_str(filesystem_uuid)
+        .map_err(|error| VolumeError::Storage(format!("invalid filesystem UUID: {error}")))?;
+    if size_mb == 0 || size_mb.checked_mul(BYTES_PER_MB).is_none() {
+        return Err(VolumeError::InvalidSize);
+    }
+    tokio::fs::create_dir(directory)
+        .await
+        .map_err(|error| VolumeError::Storage(format!("claim fresh volume directory: {error}")))?;
+    create_empty_backing_inner(directory, size_mb, Some(filesystem_uuid)).await
+}
+
+async fn create_empty_backing_inner(
+    directory: &Path,
+    size_mb: u64,
+    filesystem_uuid: Option<&str>,
+) -> Result<PathBuf, VolumeError> {
+    let raw = directory.join("base.ext4");
+    let commit = directory.join("base.commit");
+    let image_config = directory.join("image.json");
+    tokio::fs::create_dir_all(&directory)
+        .await
+        .map_err(|error| VolumeError::Storage(error.to_string()))?;
+
+    let result = async {
+        let file = tokio::fs::File::create(&raw)
+            .await
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        file.set_len(
+            size_mb
+                .checked_mul(BYTES_PER_MB)
+                .ok_or(VolumeError::InvalidSize)?,
+        )
+        .await
+        .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        drop(file);
+        let mut formatter = Command::new("mkfs.ext4");
+        formatter.args(["-q", "-F"]);
+        if let Some(uuid) = filesystem_uuid {
+            formatter.args(["-U", uuid]);
+        }
+        let status = formatter
+            .arg(&raw)
+            .status()
+            .await
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        if !status.success() {
+            return Err(VolumeError::Storage(format!(
+                "mkfs.ext4 exited with status {status}"
+            )));
+        }
+        overlaybd::tools::package_raw_as_overlaybd(&raw, &commit)
+            .await
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        let config = ImageConfig {
+            lowers: vec![LayerConfig {
+                file: commit.to_string_lossy().into_owned(),
+                ..LayerConfig::default()
+            }],
+            ..ImageConfig::default()
+        };
+        let bytes = serde_json::to_vec_pretty(&config)
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        tokio::fs::write(&image_config, bytes)
+            .await
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        let _ = tokio::fs::remove_file(&raw).await;
+        Ok(image_config)
+    }
+    .await;
+
+    // Managed operations retain partial artifacts for inspection. The legacy
+    // entrypoint preserves its original best-effort cleanup behavior.
+    if result.is_err() && filesystem_uuid.is_none() {
+        let _ = tokio::fs::remove_dir_all(&directory).await;
+    }
+    result
+}
+
+pub async fn create_child_backing(
+    directory: &Path,
+    parent_config: &Path,
+) -> Result<PathBuf, VolumeError> {
+    create_child_backing_inner(directory, parent_config, false).await
+}
+/// Claim a new managed clone directory and retain partial artifacts on errors.
+pub async fn create_identified_child_backing(
+    directory: &Path,
+    parent_config: &Path,
+) -> Result<PathBuf, VolumeError> {
+    tokio::fs::create_dir(directory)
+        .await
+        .map_err(|e| VolumeError::Storage(format!("claim managed clone directory: {e}")))?;
+    create_child_backing_inner(directory, parent_config, true).await
+}
+async fn create_child_backing_inner(
+    directory: &Path,
+    parent_config: &Path,
+    retain_on_failure: bool,
+) -> Result<PathBuf, VolumeError> {
+    let image_config = directory.join("image.json");
+    tokio::fs::create_dir_all(&directory)
+        .await
+        .map_err(|error| VolumeError::Storage(error.to_string()))?;
+
+    let result = async {
+        let bytes = tokio::fs::read(parent_config)
+            .await
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        let mut config: ImageConfig = serde_json::from_slice(&bytes)
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        for (index, layer) in config.lowers.iter_mut().enumerate() {
+            if layer.file.is_empty() {
+                continue;
+            }
+            let source = Path::new(&layer.file);
+            let extension = source
+                .extension()
+                .and_then(|extension| extension.to_str())
+                .unwrap_or("layer");
+            let destination = directory.join(format!("lower-{index}.{extension}"));
+            if let Err(link_error) = tokio::fs::hard_link(source, &destination).await {
+                tokio::fs::copy(source, &destination).await.map_err(|copy_error| {
+                    VolumeError::Storage(format!(
+                        "clone volume layer '{}' (hard link failed: {link_error}; copy failed: {copy_error})",
+                        source.display()
+                    ))
+                })?;
+            }
+            layer.file = destination.to_string_lossy().into_owned();
+        }
+        let bytes = serde_json::to_vec_pretty(&config)
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        tokio::fs::write(&image_config, bytes)
+            .await
+            .map_err(|error| VolumeError::Storage(error.to_string()))?;
+        Ok(image_config.clone())
+    }
+    .await;
+    if result.is_err() && !retain_on_failure {
+        let _ = tokio::fs::remove_dir_all(&directory).await;
+    }
+    result
+}
diff --git a/storage/volume-core/src/digest.rs b/storage/volume-core/src/digest.rs
new file mode 100644
index 0000000..7b7aad6
--- /dev/null
+++ b/storage/volume-core/src/digest.rs
@@ -0,0 +1,133 @@
+use std::fs;
+use std::io::{self, Read, Write};
+use std::path::Path;
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use tokio::io::AsyncReadExt;
+
+const DIGEST_BUFFER_SIZE: usize = 128 * 1024;
+
+/// Content identity and integrity information for a local file.
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq, Hash)]
+pub struct FileDigest {
+    /// File size in bytes, counted from the same stream used for hashing.
+    pub size: u64,
+    /// SHA-256 digest of the file bytes, formatted as `sha256:<hex>`.
+    pub sha256: String,
+}
+
+impl FileDigest {
+    /// Asynchronously opens `path`, streams its contents, and returns its size plus `sha256:<hex>` digest.
+    pub async fn describe(path: &Path) -> io::Result<Self> {
+        let mut file = tokio::fs::File::open(path).await?;
+        let (hasher, size) = hash_reader_async(&mut file).await?;
+        Ok(Self {
+            size,
+            sha256: format!("sha256:{:x}", hasher.finalize()),
+        })
+    }
+
+    /// Opens `path`, streams its contents, and returns its size plus `sha256:<hex>` digest.
+    pub fn describe_blocking(path: &Path) -> io::Result<Self> {
+        let mut file = fs::File::open(path)?;
+        let (hasher, size) = hash_reader(&mut file)?;
+        Ok(Self {
+            size,
+            sha256: format!("sha256:{:x}", hasher.finalize()),
+        })
+    }
+}
+
+/// Returns the raw 32-byte SHA-256 digest for in-memory bytes.
+pub fn sha256_bytes(bytes: &[u8]) -> [u8; 32] {
+    Sha256::digest(bytes).into()
+}
+
+/// Returns the lowercase hexadecimal SHA-256 digest for in-memory bytes.
+pub fn sha256_hex(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+/// Returns an OCI-style SHA-256 digest string (`sha256:<hex>`) for in-memory bytes.
+pub fn sha256_digest(bytes: &[u8]) -> String {
+    format!("sha256:{}", sha256_hex(bytes))
+}
+
+/// Copies all bytes from `source` to `destination` while returning the source SHA-256 hex digest and byte count.
+pub fn copy_with_sha256_hex(
+    mut source: impl Read,
+    mut destination: impl Write,
+) -> io::Result<(String, u64)> {
+    let mut hasher = Sha256::new();
+    let mut copied = 0_u64;
+    let mut buffer = [0_u8; DIGEST_BUFFER_SIZE];
+
+    loop {
+        let read = source.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        destination.write_all(&buffer[..read])?;
+        hasher.update(&buffer[..read]);
+        copied += read as u64;
+    }
+
+    Ok((format!("{:x}", hasher.finalize()), copied))
+}
+
+fn hash_reader(mut reader: impl Read) -> io::Result<(Sha256, u64)> {
+    let mut hasher = Sha256::new();
+    let mut size = 0_u64;
+    let mut buffer = [0_u8; DIGEST_BUFFER_SIZE];
+
+    loop {
+        let read = reader.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        hasher.update(&buffer[..read]);
+        size += read as u64;
+    }
+
+    Ok((hasher, size))
+}
+
+async fn hash_reader_async(
+    mut reader: impl tokio::io::AsyncRead + Unpin,
+) -> io::Result<(Sha256, u64)> {
+    let mut hasher = Sha256::new();
+    let mut size = 0_u64;
+    let mut buffer = vec![0_u8; DIGEST_BUFFER_SIZE]; // Use a heap buffer to avoid large stack allocations in async contexts.
+
+    loop {
+        let read = reader.read(&mut buffer).await?;
+        if read == 0 {
+            break;
+        }
+        hasher.update(&buffer[..read]);
+        size += read as u64;
+    }
+
+    Ok((hasher, size))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn describe_file_reports_stable_digest() {
+        let temp = tempfile::NamedTempFile::new().expect("temp");
+        std::fs::write(temp.path(), b"artifact").expect("write");
+        let described = FileDigest::describe(temp.path()).await.expect("describe");
+        assert_eq!(described.size, 8);
+        assert_eq!(
+            described.sha256,
+            "sha256:c7c5c1d70c5dec4416ab6158afd0b223ef40c29b1dc1f97ed9428b94d4cadb1c"
+        );
+        let described_blocking =
+            FileDigest::describe_blocking(temp.path()).expect("describe_blocking");
+        assert_eq!(described_blocking, described);
+    }
+}
diff --git a/storage/volume-core/src/engine.rs b/storage/volume-core/src/engine.rs
new file mode 100644
index 0000000..2f7f88e
--- /dev/null
+++ b/storage/volume-core/src/engine.rs
@@ -0,0 +1,864 @@
+//! Native volume operations shared by the API facade and managed storage host.
+use crate::catalog::{CatalogError as RepositoryError, CatalogResult};
+use crate::{
+    is_valid_volume_component, OverlaybdLayerRef, VolumeError, VolumeMode, VolumePage,
+    VolumeRecord, VolumeRecordPage, VolumeStatus, MAX_VOLUME_MOUNTS,
+};
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+use std::{
+    collections::HashMap,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+use tokio::sync::RwLock;
+use tracing::{debug, info, warn};
+use uuid::Uuid;
+#[async_trait::async_trait]
+pub trait VolumeRepository: Send + Sync {
+    async fn get_volume(&self, reference: &str) -> CatalogResult<Option<VolumeRecord>>;
+    async fn list_volumes_page(
+        &self,
+        after: Option<&str>,
+        limit: usize,
+    ) -> CatalogResult<VolumeRecordPage>;
+    async fn create_volume(&self, record: VolumeRecord) -> CatalogResult<()>;
+    async fn put_volume(&self, record: VolumeRecord) -> CatalogResult<()>;
+    /// Dedicated maintenance CAS. Legacy repository implementations remain
+    /// usable, but must explicitly implement this before supporting expansion.
+    async fn commit_expansion(
+        &self,
+        _id: &str,
+        _owner: &str,
+        _expected_size_mb: u64,
+        _expected_layers: &[OverlaybdLayerRef],
+        _size_mb: u64,
+        _layers: &[OverlaybdLayerRef],
+    ) -> CatalogResult<()> {
+        Err(RepositoryError::InvalidRequest {
+            reason: "repository does not support maintenance publication".into(),
+        })
+    }
+    async fn delete_volume(&self, id: &str) -> CatalogResult<()>;
+    async fn reserve_volume(&self, id: &str, owner: &str) -> CatalogResult<Option<String>>;
+    async fn reserve_read_only_volume(&self, id: &str, owner: &str) -> CatalogResult<()>;
+    async fn replace_volume_owner_for(
+        &self,
+        id: &str,
+        from: &str,
+        to: Option<&str>,
+    ) -> CatalogResult<()>;
+    async fn publish_volume_backing(
+        &self,
+        id: &str,
+        path: &Path,
+    ) -> CatalogResult<Vec<OverlaybdLayerRef>>;
+    async fn materialize_volume_backing(
+        &self,
+        id: &str,
+        layers: &[OverlaybdLayerRef],
+        destination: &Path,
+    ) -> CatalogResult<PathBuf>;
+}
+#[derive(Clone, Copy, Debug)]
+pub struct VolumeLimits {
+    pub max_size_mb: u64,
+    pub max_mounts: usize,
+}
+#[derive(Clone)]
+pub struct VolumeEngine {
+    records: Arc<RwLock<HashMap<String, VolumeRecord>>>,
+    root: PathBuf,
+    repository: Arc<dyn VolumeRepository>,
+    limits: VolumeLimits,
+}
+impl VolumeEngine {
+    pub fn new(
+        root: PathBuf,
+        repository: Arc<dyn VolumeRepository>,
+        mut limits: VolumeLimits,
+    ) -> Self {
+        limits.max_mounts = limits.max_mounts.min(MAX_VOLUME_MOUNTS);
+        Self {
+            records: Arc::new(RwLock::new(HashMap::new())),
+            root,
+            repository,
+            limits,
+        }
+    }
+    pub async fn get(&self, reference: &str) -> Result<VolumeRecord, VolumeError> {
+        let mut record = self
+            .repository
+            .get_volume(reference)
+            .await
+            .map_err(repository_error)?
+            .ok_or_else(|| VolumeError::NotFound(reference.to_owned()))?;
+        validate_volume_id(&record.id)?;
+        let local = self.records.read().await;
+        record.backing_image_config = current_local_backing(&record, &local);
+        Ok(record)
+    }
+    pub async fn list_page(
+        &self,
+        next_token: Option<&str>,
+        limit: usize,
+    ) -> Result<VolumePage, VolumeError> {
+        if limit == 0 {
+            return Err(VolumeError::InvalidPageLimit);
+        }
+        let after_volume_id = next_token.map(decode_volume_cursor).transpose()?;
+        let mut page = self
+            .repository
+            .list_volumes_page(after_volume_id.as_deref(), limit)
+            .await
+            .map_err(repository_error)?;
+        let local = self.records.read().await;
+        for record in &mut page.records {
+            validate_volume_id(&record.id)?;
+            record.backing_image_config = current_local_backing(record, &local);
+        }
+        Ok(VolumePage {
+            records: page.records,
+            next_token: page.next_volume_id.map(encode_volume_cursor),
+        })
+    }
+    pub fn data_dir(&self, volume_id: &str) -> PathBuf {
+        self.root.join("data").join(volume_id)
+    }
+    pub fn max_size_mb(&self) -> u64 {
+        self.limits.max_size_mb
+    }
+    pub async fn commit_expansion(
+        &self,
+        id: &str,
+        owner: &str,
+        expected_size_mb: u64,
+        expected_layers: &[OverlaybdLayerRef],
+        size_mb: u64,
+        layers: &[OverlaybdLayerRef],
+    ) -> Result<(), VolumeError> {
+        validate_volume_id(id)?;
+        if size_mb > self.limits.max_size_mb {
+            return Err(VolumeError::SizeLimitExceeded {
+                max_size_mb: self.limits.max_size_mb,
+            });
+        }
+        self.repository
+            .commit_expansion(
+                id,
+                owner,
+                expected_size_mb,
+                expected_layers,
+                size_mb,
+                layers,
+            )
+            .await
+            .map_err(repository_error)?;
+        // Cached image configs represent the old capacity/content generation.
+        self.records.write().await.remove(id);
+        Ok(())
+    }
+    pub async fn materialize_captured_backing(
+        &self,
+        id: &str,
+        layers: &[OverlaybdLayerRef],
+        destination: &Path,
+    ) -> Result<PathBuf, VolumeError> {
+        validate_volume_id(id)?;
+        self.repository
+            .materialize_volume_backing(id, layers, destination)
+            .await
+            .map_err(repository_error)
+    }
+    pub async fn materialize_backing(&self, reference: &str) -> Result<VolumeRecord, VolumeError> {
+        let mut record = self.get(reference).await?;
+        if record
+            .backing_image_config
+            .as_ref()
+            .is_some_and(|path| path.exists())
+            || record.backing_layers.is_empty()
+        {
+            return Ok(record);
+        }
+        let destination = self.data_dir(&record.id).join("image.json");
+        debug!(
+            volume_id = %record.id,
+            layer_count = record.backing_layers.len(),
+            "materializing volume backing"
+        );
+        let path = self
+            .repository
+            .materialize_volume_backing(&record.id, &record.backing_layers, &destination)
+            .await
+            .map_err(repository_error)?;
+        debug!(
+            volume_id = %record.id,
+            path = %path.display(),
+            "volume backing materialized"
+        );
+        record.backing_image_config = Some(path);
+        self.cache_record(record.clone()).await;
+        Ok(record)
+    }
+    pub async fn create(
+        &self,
+        name: String,
+        mode: VolumeMode,
+        from_volume: Option<String>,
+        source_config: Option<PathBuf>,
+        size_mb: u64,
+    ) -> Result<VolumeRecord, VolumeError> {
+        self.create_with_source_owner(
+            name,
+            mode,
+            from_volume.map(|reference| (reference, None)),
+            source_config,
+            size_mb,
+            None,
+        )
+        .await
+    }
+    /// Creates a private writable child without publishing its unchanged backing first.
+    /// The caller holds a read lease on the immutable seed until this child is released.
+    pub async fn create_build_cache(
+        &self,
+        name: String,
+        seed: Option<String>,
+        size_mb: u64,
+        owner: &str,
+    ) -> Result<VolumeRecord, VolumeError> {
+        self.create_with_source_owner(
+            name,
+            VolumeMode::Exclusive,
+            seed.map(|id| (id, None)),
+            None,
+            size_mb,
+            Some(owner),
+        )
+        .await
+    }
+    /// Register an immutable captured backing, preserving its layers instead
+    /// of formatting or materializing a replacement empty disk.
+    pub async fn register_snapshot(
+        &self,
+        record: VolumeRecord,
+    ) -> Result<VolumeRecord, VolumeError> {
+        validate_volume_id(&record.id)?;
+        validate_name(&record.name)?;
+        if record.size_mb == 0
+            || record.backing_layers.is_empty()
+            || record.backing_image_config.is_some()
+            || record.status != VolumeStatus::Ready
+            || record.deleting
+            || record.reserved_by_sandbox_id.is_some()
+            || !record.read_only_mounts.is_empty()
+        {
+            return Err(VolumeError::InvalidSize);
+        }
+        if record.size_mb > self.limits.max_size_mb {
+            return Err(VolumeError::SizeLimitExceeded {
+                max_size_mb: self.limits.max_size_mb,
+            });
+        }
+        self.repository
+            .create_volume(record.clone())
+            .await
+            .map_err(repository_error)?;
+        self.cache_record(record.clone()).await;
+        Ok(record)
+    }
+    /// Execute one already-journaled managed create. The caller owns the
+    /// operation lock and pins source_config to an immutable captured head.
+    /// Unlike legacy create, failures retain artifacts for same-operation recovery.
+    pub async fn create_identified(
+        &self,
+        id: &str,
+        filesystem_uuid: &str,
+        mode: VolumeMode,
+        source_config: Option<PathBuf>,
+        size_mb: u64,
+    ) -> Result<VolumeRecord, VolumeError> {
+        validate_volume_id(id)?;
+        let uuid =
+            Uuid::parse_str(filesystem_uuid).map_err(|e| VolumeError::Storage(e.to_string()))?;
+        if uuid.is_nil() {
+            return Err(VolumeError::Storage("nil filesystem identity".into()));
+        }
+        if mode == VolumeMode::ReadOnly && source_config.is_none() {
+            return Err(VolumeError::Storage(
+                "readonly blank volume cannot be initialized".into(),
+            ));
+        }
+        self.create_inner(
+            id.to_owned(),
+            mode,
+            None,
+            source_config,
+            size_mb,
+            None,
+            Some((id, filesystem_uuid)),
+        )
+        .await
+    }
+    async fn create_with_source_owner(
+        &self,
+        name: String,
+        mode: VolumeMode,
+        from_volume: Option<(String, Option<&str>)>,
+        source_config: Option<PathBuf>,
+        size_mb: u64,
+        reserved_owner: Option<&str>,
+    ) -> Result<VolumeRecord, VolumeError> {
+        self.create_inner(
+            name,
+            mode,
+            from_volume,
+            source_config,
+            size_mb,
+            reserved_owner,
+            None,
+        )
+        .await
+    }
+    async fn create_inner(
+        &self,
+        name: String,
+        mode: VolumeMode,
+        from_volume: Option<(String, Option<&str>)>,
+        source_config: Option<PathBuf>,
+        size_mb: u64,
+        reserved_owner: Option<&str>,
+        allocated: Option<(&str, &str)>,
+    ) -> Result<VolumeRecord, VolumeError> {
+        validate_name(&name)?;
+        if size_mb == 0 {
+            return Err(VolumeError::InvalidSize);
+        }
+        if size_mb > self.limits.max_size_mb {
+            return Err(VolumeError::SizeLimitExceeded {
+                max_size_mb: self.limits.max_size_mb,
+            });
+        }
+        if from_volume.is_some() && source_config.is_some() {
+            return Err(VolumeError::MultipleSources);
+        }
+        match self.get(&name).await {
+            Ok(_) => return Err(VolumeError::NameConflict(name)),
+            Err(VolumeError::NotFound(_)) => {}
+            Err(error) => return Err(error),
+        }
+
+        let id = allocated
+            .map(|(id, _)| id.to_owned())
+            .unwrap_or_else(|| format!("vol_{}", Uuid::now_v7().simple()));
+        if allocated.is_some() {
+            match self.get(&id).await {
+                Ok(_) => return Err(VolumeError::NameConflict(id)),
+                Err(VolumeError::NotFound(_)) => (),
+                Err(error) => return Err(error),
+            }
+            if tokio::fs::try_exists(self.data_dir(&id))
+                .await
+                .map_err(|e| VolumeError::Storage(e.to_string()))?
+            {
+                return Err(VolumeError::Storage(
+                    "managed create already has artifacts; inspect the original operation".into(),
+                ));
+            }
+        }
+        debug!(
+            volume_id = %id,
+            mode = ?mode,
+            size_mb,
+            "creating volume"
+        );
+        let mut backing_layers = Vec::new();
+        let backing_image_config = if let Some((reference, source_owner)) = from_volume {
+            let mut parent = match self.get(&reference).await {
+                Ok(parent) => parent,
+                Err(VolumeError::NotFound(_)) => {
+                    return Err(VolumeError::SourceNotFound(reference))
+                }
+                Err(error) => return Err(error),
+            };
+            match parent.status {
+                VolumeStatus::Uploading => return Err(VolumeError::Uploading(parent.id.clone())),
+                VolumeStatus::Failed => return Err(VolumeError::Failed(parent.id.clone())),
+                VolumeStatus::Ready => {}
+            }
+            if let Some(owner) = parent.reserved_by_sandbox_id.as_deref() {
+                if source_owner != Some(owner) {
+                    return Err(VolumeError::Reserved(owner.to_owned()));
+                }
+            }
+            if parent.size_mb != size_mb {
+                return Err(VolumeError::SizeMismatch);
+            }
+            if parent.reserved_by_sandbox_id.is_none() && !parent.backing_layers.is_empty() {
+                // Committed layers are immutable and repository-owned. Materializing
+                // the child on mount preserves their descriptors without copying or
+                // republishing the parent's local files. Reserved parents may have
+                // newer local writes, so they still need the local clone below.
+                backing_layers = parent.backing_layers;
+                None
+            } else {
+                if parent.backing_image_config.is_none() && !parent.backing_layers.is_empty() {
+                    parent = self.materialize_backing(&parent.id).await?;
+                }
+                match parent.backing_image_config.as_ref() {
+                    Some(path) => Some(self.create_child_backing(&id, path).await?),
+                    None => None,
+                }
+            }
+        } else if let Some(source_config) = source_config {
+            if allocated.is_some() {
+                let directory = self.data_dir(&id);
+                if let Some(parent) = directory.parent() {
+                    tokio::fs::create_dir_all(parent)
+                        .await
+                        .map_err(|e| VolumeError::Storage(e.to_string()))?;
+                }
+                Some(
+                    crate::content::create_identified_child_backing(&directory, &source_config)
+                        .await?,
+                )
+            } else {
+                Some(self.create_child_backing(&id, &source_config).await?)
+            }
+        } else if let Some((_, uuid)) = allocated {
+            let directory = self.data_dir(&id);
+            if let Some(parent) = directory.parent() {
+                tokio::fs::create_dir_all(parent)
+                    .await
+                    .map_err(|e| VolumeError::Storage(e.to_string()))?;
+            }
+            Some(crate::content::create_identified_empty_backing(&directory, size_mb, uuid).await?)
+        } else {
+            Some(self.create_empty_backing(&id, size_mb).await?)
+        };
+
+        let mut record = VolumeRecord {
+            id,
+            name,
+            mode,
+            size_mb,
+            status: VolumeStatus::Ready,
+            reserved_by_sandbox_id: reserved_owner.map(str::to_owned),
+            backing_image_config,
+            backing_layers,
+            read_only_mounts: Vec::new(),
+            deleting: false,
+        };
+        let create_result = async {
+            if reserved_owner.is_none() {
+                self.publish_backing(&mut record).await?;
+            }
+            self.repository
+                .create_volume(record.clone())
+                .await
+                .map_err(repository_error)?;
+            self.cache_record(record.clone()).await;
+            Ok(())
+        }
+        .await;
+        if let Err(error) = create_result {
+            if allocated.is_some() {
+                return Err(error);
+            }
+            if let Some(config) = record.backing_image_config.as_ref() {
+                if let Some(directory) = config.parent() {
+                    let _ = tokio::fs::remove_dir_all(directory).await;
+                }
+            }
+            return Err(error);
+        }
+        info!(
+            volume_id = %record.id,
+            mode = ?record.mode,
+            size_mb = record.size_mb,
+            "volume created"
+        );
+        Ok(record)
+    }
+    pub async fn delete(&self, reference: &str) -> Result<(), VolumeError> {
+        let record = self.get(reference).await?;
+        if let Some(owner) = record.reserved_by_sandbox_id.as_deref() {
+            return Err(VolumeError::Reserved(owner.to_owned()));
+        }
+        if let Some(owner) = record.read_only_mounts.first() {
+            return Err(VolumeError::Reserved(owner.clone()));
+        }
+        debug!(volume_id = %record.id, "deleting volume");
+        self.repository
+            .delete_volume(&record.id)
+            .await
+            .map_err(repository_error)?;
+        let backing_directory = self.data_dir(&record.id);
+        self.records.write().await.remove(&record.id);
+        if let Err(error) = tokio::fs::remove_dir_all(&backing_directory).await {
+            if error.kind() != std::io::ErrorKind::NotFound {
+                warn!(
+                    volume_id = %record.id,
+                    path = %backing_directory.display(),
+                    %error,
+                    "failed to clean deleted volume's node-local backing"
+                );
+            }
+        }
+        info!(volume_id = %record.id, "volume deleted");
+        Ok(())
+    }
+    pub async fn create_child_for_owner(
+        &self,
+        reference: &str,
+        name: String,
+        mode: VolumeMode,
+        size_mb: u64,
+        source_owner: &str,
+        child_owner: &str,
+    ) -> Result<VolumeRecord, VolumeError> {
+        self.create_with_source_owner(
+            name,
+            mode,
+            Some((reference.to_owned(), Some(source_owner))),
+            None,
+            size_mb,
+            Some(child_owner),
+        )
+        .await
+    }
+    /// Publish exactly the immutable config saved inside a joint capture.
+    /// This must not update the live volume catalog or re-read its current head.
+    pub async fn commit_captured_layers(
+        &self,
+        id: &str,
+        owner: &str,
+        layers: Vec<OverlaybdLayerRef>,
+    ) -> Result<(), VolumeError> {
+        let mut record = self.get(id).await?;
+        if record.mode != VolumeMode::Exclusive
+            || record.reserved_by_sandbox_id.as_deref() != Some(owner)
+        {
+            return Err(VolumeError::Reserved(
+                record.reserved_by_sandbox_id.unwrap_or_default(),
+            ));
+        }
+        if layers.is_empty() {
+            return Err(VolumeError::Storage(
+                "captured native backing is empty".into(),
+            ));
+        }
+        if record.backing_layers == layers && record.status == VolumeStatus::Ready {
+            return Ok(());
+        }
+        record.status = VolumeStatus::Uploading;
+        self.persist_catalog(&record).await?;
+        record.backing_layers = layers;
+        record.backing_image_config = None;
+        record.status = VolumeStatus::Ready;
+        self.persist_catalog(&record).await?;
+        self.cache_record(record).await;
+        Ok(())
+    }
+    pub async fn publish_captured_backing(
+        &self,
+        volume_id: &str,
+        image_config_path: &Path,
+    ) -> Result<Vec<OverlaybdLayerRef>, VolumeError> {
+        self.repository
+            .publish_volume_backing(volume_id, image_config_path)
+            .await
+            .map_err(repository_error)
+    }
+    pub async fn snapshot_volume_state(
+        &self,
+        reference: &str,
+    ) -> Result<VolumeRecord, VolumeError> {
+        let mut parent = self.get(reference).await?;
+        // A running sandbox restacks its volume upper into this same local
+        // image config before capture. Publish that latest state before making
+        // the logical volume snapshot.
+        let owner = parent.reserved_by_sandbox_id.clone();
+        if let Some(owner) = owner.as_deref() {
+            self.recover_and_publish_backings(owner, std::slice::from_ref(&parent.id))
+                .await?;
+            parent = self.get(reference).await?;
+        } else {
+            self.publish_backing(&mut parent).await?;
+            self.persist_catalog(&parent).await?;
+            self.cache_record(parent.clone()).await;
+        }
+        Ok(parent)
+    }
+    pub async fn reserve(&self, reference: &str, owner: &str) -> Result<(), VolumeError> {
+        let mut record = self.get(reference).await?;
+        match record.status {
+            VolumeStatus::Uploading => return Err(VolumeError::Uploading(record.id.clone())),
+            VolumeStatus::Failed => return Err(VolumeError::Failed(record.id.clone())),
+            VolumeStatus::Ready => {}
+        }
+        if record.mode == VolumeMode::ReadOnly {
+            self.repository
+                .reserve_read_only_volume(&record.id, owner)
+                .await
+                .map_err(repository_error)?;
+            if !record.read_only_mounts.iter().any(|entry| entry == owner) {
+                record.read_only_mounts.push(owner.to_owned());
+            }
+            debug!(volume_id = %record.id, "read-only volume reserved");
+            self.cache_record(record).await;
+            return Ok(());
+        }
+        if let Some(existing) = self
+            .repository
+            .reserve_volume(&record.id, owner)
+            .await
+            .map_err(repository_error)?
+        {
+            return Err(VolumeError::Reserved(existing));
+        }
+        record.reserved_by_sandbox_id = Some(owner.to_owned());
+        debug!(volume_id = %record.id, "exclusive volume reserved");
+        self.cache_record(record).await;
+        Ok(())
+    }
+    pub async fn replace_owner_for(
+        &self,
+        owner: &str,
+        new_owner: Option<&str>,
+        volume_ids: &[String],
+    ) -> Result<(), VolumeError> {
+        for volume_id in volume_ids {
+            self.repository
+                .replace_volume_owner_for(volume_id, owner, new_owner)
+                .await
+                .map_err(repository_error)?;
+            if let Some(record) = self.records.write().await.get_mut(volume_id) {
+                record.replace_owner(owner, new_owner);
+            }
+            match new_owner {
+                Some(new_owner) => debug!(
+                    volume_id = %volume_id,
+                    previous_owner = %owner,
+                    new_owner = %new_owner,
+                    "volume reservation owner replaced"
+                ),
+                None => debug!(volume_id = %volume_id, %owner, "volume reservation released"),
+            }
+        }
+        Ok(())
+    }
+    /// Keep an incomplete capture unavailable after its sandbox is stopped.
+    pub async fn fail_backings(
+        &self,
+        owner: &str,
+        volume_ids: &[String],
+    ) -> Result<(), VolumeError> {
+        for volume_id in volume_ids {
+            let mut record = self.get(volume_id).await?;
+            if record.reserved_by_sandbox_id.as_deref() == Some(owner) {
+                record.status = VolumeStatus::Failed;
+                self.persist_catalog(&record).await?;
+                self.cache_record(record).await;
+            }
+        }
+        Ok(())
+    }
+    pub async fn publish_backings(
+        &self,
+        owner: &str,
+        volume_ids: &[String],
+    ) -> Result<(), VolumeError> {
+        let mut records = Vec::with_capacity(volume_ids.len());
+        for volume_id in volume_ids {
+            let record = self.get(volume_id).await?;
+            if record.mounted_by(owner) {
+                records.push(record);
+            }
+        }
+        self.publish_records(owner, records).await
+    }
+    /// Restores deterministic node-local config paths after a server restart.
+    pub async fn recover_backings(
+        &self,
+        owner: &str,
+        volume_ids: &[String],
+    ) -> Result<(), VolumeError> {
+        for volume_id in volume_ids {
+            let mut record = self.get(volume_id).await?;
+            if record.reserved_by_sandbox_id.as_deref() != Some(owner) {
+                continue;
+            }
+            if record.backing_image_config.is_none() {
+                let path = self.data_dir(&record.id).join("image.json");
+                if !path.exists() {
+                    record.status = VolumeStatus::Failed;
+                    if let Err(error) = self.persist_catalog(&record).await {
+                        warn!(
+                            volume_id = %record.id,
+                            %error,
+                            "failed to persist volume failure status"
+                        );
+                    }
+                    self.cache_record(record.clone()).await;
+                    warn!(
+                        volume_id = %record.id,
+                        path = %path.display(),
+                        "reserved volume backing is missing"
+                    );
+                    return Err(VolumeError::Storage(format!(
+                        "local backing for reserved volume '{}' is missing",
+                        record.id
+                    )));
+                }
+                record.backing_image_config = Some(path);
+                debug!(volume_id = %record.id, %owner, "volume backing recovered");
+                self.cache_record(record).await;
+            }
+        }
+        Ok(())
+    }
+    pub async fn recover_and_publish_backings(
+        &self,
+        owner: &str,
+        volume_ids: &[String],
+    ) -> Result<(), VolumeError> {
+        self.recover_backings(owner, volume_ids).await?;
+        self.publish_backings(owner, volume_ids).await
+    }
+    async fn publish_records(
+        &self,
+        owner: &str,
+        records: Vec<VolumeRecord>,
+    ) -> Result<(), VolumeError> {
+        for mut record in records {
+            if record.reserved_by_sandbox_id.as_deref() != Some(owner) {
+                continue;
+            }
+            // Publish the state transition before uploading any writable
+            // upper layer so other nodes cannot mount stale content.
+            record.status = VolumeStatus::Uploading;
+            if let Err(error) = self.persist_catalog(&record).await {
+                self.mark_publication_failed(record, "mark_uploading", &error)
+                    .await;
+                return Err(error);
+            }
+            self.cache_record(record.clone()).await;
+            debug!(volume_id = %record.id, "publishing volume backing");
+            if let Err(error) = self.publish_backing(&mut record).await {
+                self.mark_publication_failed(record, "publish_backing", &error)
+                    .await;
+                return Err(error);
+            }
+            record.status = VolumeStatus::Ready;
+            if let Err(error) = self.persist_catalog(&record).await {
+                self.mark_publication_failed(record, "mark_ready", &error)
+                    .await;
+                return Err(error);
+            }
+            info!(
+                volume_id = %record.id,
+                layer_count = record.backing_layers.len(),
+                "volume backing published"
+            );
+            self.cache_record(record).await;
+        }
+        Ok(())
+    }
+    async fn mark_publication_failed(
+        &self,
+        mut record: VolumeRecord,
+        stage: &'static str,
+        error: &VolumeError,
+    ) {
+        record.status = VolumeStatus::Failed;
+        if let Err(status_error) = self.persist_catalog(&record).await {
+            warn!(
+                volume_id = %record.id,
+                error = %status_error,
+                "failed to persist volume failure status"
+            );
+        }
+        warn!(
+            volume_id = %record.id,
+            stage,
+            %error,
+            "volume backing publication failed"
+        );
+        self.cache_record(record).await;
+    }
+    pub async fn cache_record(&self, record: VolumeRecord) {
+        self.records.write().await.insert(record.id.clone(), record);
+    }
+    async fn publish_backing(&self, record: &mut VolumeRecord) -> Result<(), VolumeError> {
+        if let Some(path) = record.backing_image_config.as_deref() {
+            record.backing_layers = self
+                .repository
+                .publish_volume_backing(&record.id, path)
+                .await
+                .map_err(repository_error)?;
+        }
+        Ok(())
+    }
+    async fn persist_catalog(&self, record: &VolumeRecord) -> Result<(), VolumeError> {
+        self.repository
+            .put_volume(record.clone())
+            .await
+            .map_err(repository_error)
+    }
+    async fn create_empty_backing(
+        &self,
+        volume_id: &str,
+        size_mb: u64,
+    ) -> Result<PathBuf, VolumeError> {
+        crate::content::create_empty_backing(&self.data_dir(volume_id), size_mb).await
+    }
+    async fn create_child_backing(
+        &self,
+        volume_id: &str,
+        parent_config: &Path,
+    ) -> Result<PathBuf, VolumeError> {
+        crate::content::create_child_backing(&self.data_dir(volume_id), parent_config).await
+    }
+}
+fn current_local_backing(
+    remote: &VolumeRecord,
+    local: &HashMap<String, VolumeRecord>,
+) -> Option<PathBuf> {
+    local
+        .get(&remote.id)
+        .filter(|record| record.backing_layers == remote.backing_layers)
+        .and_then(|record| record.backing_image_config.clone())
+        .filter(|path| path.exists())
+}
+fn repository_error(error: RepositoryError) -> VolumeError {
+    match error {
+        RepositoryError::VolumeNotFound { lookup } => VolumeError::NotFound(lookup),
+        RepositoryError::VolumeNameConflict { name } => VolumeError::NameConflict(name),
+        error => VolumeError::Storage(error.to_string()),
+    }
+}
+fn encode_volume_cursor(volume_id: String) -> String {
+    URL_SAFE_NO_PAD.encode(volume_id)
+}
+fn decode_volume_cursor(token: &str) -> Result<String, VolumeError> {
+    let bytes = URL_SAFE_NO_PAD
+        .decode(token)
+        .map_err(|_| VolumeError::InvalidNextToken)?;
+    let volume_id = String::from_utf8(bytes).map_err(|_| VolumeError::InvalidNextToken)?;
+    validate_volume_id(&volume_id).map_err(|_| VolumeError::InvalidNextToken)?;
+    Ok(volume_id)
+}
+fn validate_name(name: &str) -> Result<(), VolumeError> {
+    if is_valid_volume_component(name) {
+        Ok(())
+    } else {
+        Err(VolumeError::InvalidName)
+    }
+}
+fn validate_volume_id(id: &str) -> Result<(), VolumeError> {
+    if is_valid_volume_component(id) {
+        Ok(())
+    } else {
+        Err(VolumeError::Storage(format!("invalid volume id '{id}'")))
+    }
+}
diff --git a/storage/volume-core/src/head_repository.rs b/storage/volume-core/src/head_repository.rs
new file mode 100644
index 0000000..d2b8f7f
--- /dev/null
+++ b/storage/volume-core/src/head_repository.rs
@@ -0,0 +1,142 @@
+//! Head metadata transport uses the same conditional object operations as the
+//! native volume catalog; object content and current-head CAS are separate.
+use crate::{
+    catalog::{CatalogError, CatalogResult},
+    heads::{PosixHeadStore, PublishedHead},
+    is_valid_volume_component,
+    object::VolumeObjectStore,
+};
+use async_trait::async_trait;
+use std::sync::Arc;
+#[async_trait]
+pub trait HeadRepository: Send + Sync {
+    async fn read(&self, id: &str, revision: &str) -> CatalogResult<Option<PublishedHead>>;
+    async fn current(&self, id: &str) -> CatalogResult<Option<PublishedHead>>;
+    async fn publish(&self, expected: Option<&str>, head: &PublishedHead) -> CatalogResult<()>;
+}
+#[async_trait]
+impl HeadRepository for PosixHeadStore {
+    async fn read(&self, id: &str, revision: &str) -> CatalogResult<Option<PublishedHead>> {
+        let store = self.clone();
+        let id = id.to_owned();
+        let revision = revision.to_owned();
+        tokio::task::spawn_blocking(move || store.read(&id, &revision))
+            .await
+            .map_err(error)?
+    }
+    async fn current(&self, id: &str) -> CatalogResult<Option<PublishedHead>> {
+        let store = self.clone();
+        let id = id.to_owned();
+        tokio::task::spawn_blocking(move || store.current(&id))
+            .await
+            .map_err(error)?
+    }
+    async fn publish(&self, expected: Option<&str>, head: &PublishedHead) -> CatalogResult<()> {
+        let store = self.clone();
+        let expected = expected.map(str::to_owned);
+        let head = head.clone();
+        tokio::task::spawn_blocking(move || store.publish(expected.as_deref(), &head))
+            .await
+            .map_err(error)?
+    }
+}
+pub struct ObjectHeadStore<C: VolumeObjectStore> {
+    client: Arc<C>,
+}
+impl<C: VolumeObjectStore> ObjectHeadStore<C> {
+    pub fn new(client: Arc<C>) -> Self {
+        Self { client }
+    }
+    async fn load(&self, id: &str, key: &str) -> CatalogResult<Option<(PublishedHead, String)>> {
+        let (bytes, etag) = match self.client.get_bytes_with_etag(key).await {
+            Ok(value) => value,
+            Err(e) if C::is_not_found_error(&e) => return Ok(None),
+            Err(e) => return Err(error(e)),
+        };
+        if bytes.len() > 4 * 1024 * 1024 {
+            return Err(invalid("oversized head metadata"));
+        }
+        let head: PublishedHead = serde_json::from_slice(&bytes).map_err(error)?;
+        head.validate()?;
+        if head.volume_id != id {
+            return Err(invalid("object head identity mismatch"));
+        }
+        let etag = etag
+            .filter(|v| !v.is_empty())
+            .ok_or_else(|| invalid("object head CAS requires ETag"))?;
+        Ok(Some((head, etag)))
+    }
+}
+#[async_trait]
+impl<C: VolumeObjectStore> HeadRepository for ObjectHeadStore<C> {
+    async fn read(&self, id: &str, revision: &str) -> CatalogResult<Option<PublishedHead>> {
+        valid_id(id)?;
+        if revision.len() != 64 || !revision.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(invalid("invalid immutable head revision"));
+        }
+        let head = self
+            .load(id, &format!("managed-heads/{id}/heads/{revision}.json"))
+            .await?
+            .map(|(head, _)| head);
+        if head.as_ref().is_some_and(|h| h.revision != revision) {
+            return Err(invalid("immutable object head revision mismatch"));
+        }
+        Ok(head)
+    }
+    async fn current(&self, id: &str) -> CatalogResult<Option<PublishedHead>> {
+        valid_id(id)?;
+        Ok(self
+            .load(id, &format!("managed-heads/{id}/current.json"))
+            .await?
+            .map(|(head, _)| head))
+    }
+    async fn publish(&self, expected: Option<&str>, head: &PublishedHead) -> CatalogResult<()> {
+        head.validate()?;
+        let id = &head.volume_id;
+        valid_id(id)?;
+        let current = format!("managed-heads/{id}/current.json");
+        let prior = self.load(id, &current).await?;
+        if prior.as_ref().is_some_and(|(prior, _)| prior == head) {
+            return Ok(());
+        }
+        head.validate_transition(prior.as_ref().map(|(head, _)| head), expected)?;
+        let raw = serde_json::to_vec(head).map_err(error)?;
+        let immutable = format!("managed-heads/{id}/heads/{}.json", head.revision);
+        if !self
+            .client
+            .put_bytes_conditionally(&immutable, raw.clone(), None)
+            .await
+            .map_err(error)?
+        {
+            if self.load(id, &immutable).await?.map(|(h, _)| h).as_ref() != Some(head) {
+                return Err(invalid("immutable head object conflict"));
+            }
+        }
+        if !self
+            .client
+            .put_bytes_conditionally(&current, raw, prior.as_ref().map(|(_, etag)| etag.as_str()))
+            .await
+            .map_err(error)?
+        {
+            if self.load(id, &current).await?.map(|(h, _)| h).as_ref() != Some(head) {
+                return Err(invalid("current head conditional publication conflict"));
+            }
+        }
+        Ok(())
+    }
+}
+fn valid_id(id: &str) -> CatalogResult<()> {
+    if is_valid_volume_component(id) {
+        Ok(())
+    } else {
+        Err(invalid("invalid volume identity"))
+    }
+}
+fn invalid(reason: &str) -> CatalogError {
+    CatalogError::InvalidRequest {
+        reason: reason.into(),
+    }
+}
+fn error(e: impl Into<anyhow::Error>) -> CatalogError {
+    CatalogError::backend("native head transport", e)
+}
diff --git a/storage/volume-core/src/heads.rs b/storage/volume-core/src/heads.rs
new file mode 100644
index 0000000..b9b097b
--- /dev/null
+++ b/storage/volume-core/src/heads.rs
@@ -0,0 +1,220 @@
+//! Durable native head publication. SSF authorizes use/maintenance; this store
+//! only enforces repository generation CAS and immutable content descriptors.
+use crate::{
+    catalog::{CatalogError, CatalogResult},
+    is_valid_volume_component, OverlaybdLayerRef,
+};
+use nix::fcntl::{Flock, FlockArg};
+use serde::{Deserialize, Serialize};
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{Read, Write},
+    os::unix::fs::OpenOptionsExt,
+    path::{Path, PathBuf},
+};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PublishedHead {
+    pub version: u32,
+    pub volume_id: String,
+    pub revision: String,
+    pub parent: Option<String>,
+    pub capacity_bytes: u64,
+    pub capacity_generation: u64,
+    pub filesystem_uuid: String,
+    pub layers: Vec<OverlaybdLayerRef>,
+    pub operation_id: String,
+    pub input_digest: String,
+}
+impl PublishedHead {
+    pub fn seal(mut self) -> CatalogResult<Self> {
+        self.revision.clear();
+        self.revision = crate::digest::sha256_digest(&serde_json::to_vec(&self).map_err(error)?)
+            .trim_start_matches("sha256:")
+            .to_owned();
+        self.validate()?;
+        Ok(self)
+    }
+    pub fn validate_transition(
+        &self,
+        prior: Option<&Self>,
+        expected: Option<&str>,
+    ) -> CatalogResult<()> {
+        if prior.map(|h| h.revision.as_str()) != expected || self.parent.as_deref() != expected {
+            return Err(invalid("native head publication CAS conflict"));
+        }
+        if let Some(prior) = prior {
+            if self.capacity_bytes < prior.capacity_bytes
+                || (self.capacity_bytes == prior.capacity_bytes
+                    && self.capacity_generation != prior.capacity_generation)
+                || (self.capacity_bytes > prior.capacity_bytes
+                    && self.capacity_generation
+                        != prior
+                            .capacity_generation
+                            .checked_add(1)
+                            .ok_or_else(|| invalid("capacity generation overflow"))?)
+                || self.filesystem_uuid != prior.filesystem_uuid
+            {
+                return Err(invalid(
+                    "native capacity generation or filesystem identity conflict",
+                ));
+            }
+        } else if self.capacity_generation != 1 {
+            return Err(invalid("initial capacity generation must be one"));
+        }
+        Ok(())
+    }
+    pub fn validate(&self) -> CatalogResult<()> {
+        if self.version != 1
+            || !is_valid_volume_component(&self.volume_id)
+            || !is_valid_volume_component(&self.operation_id)
+            || !hash(&self.input_digest)
+            || !hash(&self.revision)
+            || self.parent.as_ref().is_some_and(|v| !hash(v))
+            || self.capacity_bytes == 0
+            || self.capacity_bytes % 512 != 0
+            || self.capacity_generation == 0
+            || self.layers.is_empty()
+            || uuid::Uuid::parse_str(&self.filesystem_uuid).map_or(true, |u| {
+                u.is_nil() || u.to_string() != self.filesystem_uuid
+            })
+        {
+            return Err(invalid("invalid native published head"));
+        }
+        let mut body = self.clone();
+        body.revision.clear();
+        let computed = crate::digest::sha256_digest(&serde_json::to_vec(&body).map_err(error)?);
+        if computed.trim_start_matches("sha256:") != self.revision {
+            return Err(invalid("native head digest mismatch"));
+        }
+        Ok(())
+    }
+}
+#[derive(Clone)]
+pub struct PosixHeadStore {
+    root: PathBuf,
+}
+impl PosixHeadStore {
+    pub fn new(root: PathBuf) -> CatalogResult<Self> {
+        if !root.is_absolute() {
+            return Err(invalid("absolute managed head root required"));
+        }
+        Ok(Self { root })
+    }
+    fn directory(&self, id: &str) -> CatalogResult<PathBuf> {
+        if !is_valid_volume_component(id) {
+            return Err(invalid("invalid managed volume identity"));
+        }
+        Ok(self.root.join(id))
+    }
+    pub fn read(&self, id: &str, revision: &str) -> CatalogResult<Option<PublishedHead>> {
+        if !hash(revision) {
+            return Err(invalid("invalid head revision"));
+        }
+        let head = read_head(
+            &self
+                .directory(id)?
+                .join("heads")
+                .join(format!("{revision}.json")),
+        )?;
+        if head
+            .as_ref()
+            .is_some_and(|h| h.volume_id != id || h.revision != revision)
+        {
+            return Err(invalid("head identity mismatch"));
+        }
+        Ok(head)
+    }
+    pub fn current(&self, id: &str) -> CatalogResult<Option<PublishedHead>> {
+        let head = read_head(&self.directory(id)?.join("current.json"))?;
+        if head.as_ref().is_some_and(|h| h.volume_id != id) {
+            return Err(invalid("current head identity mismatch"));
+        }
+        Ok(head)
+    }
+    pub fn publish(&self, expected: Option<&str>, head: &PublishedHead) -> CatalogResult<()> {
+        head.validate()?;
+        let directory = self.directory(&head.volume_id)?;
+        fs::create_dir_all(directory.join("heads")).map_err(error)?;
+        let file = OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .read(true)
+            .write(true)
+            .mode(0o600)
+            .custom_flags(nix::libc::O_NOFOLLOW)
+            .open(directory.join("publish.lock"))
+            .map_err(error)?;
+        let _lock =
+            Flock::lock(file, FlockArg::LockExclusiveNonblock).map_err(|(_, e)| error(e))?;
+        let prior = self.current(&head.volume_id)?;
+        if prior.as_ref() == Some(head) {
+            return Ok(());
+        }
+        head.validate_transition(prior.as_ref(), expected)?;
+        let path = directory
+            .join("heads")
+            .join(format!("{}.json", head.revision));
+        match read_head(&path)? {
+            Some(existing) if existing != *head => {
+                return Err(invalid("immutable native head conflict"))
+            }
+            Some(_) => (),
+            None => write_head(&path, head)?,
+        }
+        // Pin the immutable head before making it current. A crash leaves a retained
+        // head or the old current pointer, never a pointer to an absent descriptor.
+        write_head(&directory.join("current.json"), head)?;
+        File::open(&self.root)
+            .and_then(|f| f.sync_all())
+            .map_err(error)
+    }
+}
+fn hash(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn invalid(reason: &str) -> CatalogError {
+    CatalogError::InvalidRequest {
+        reason: reason.into(),
+    }
+}
+fn error(e: impl Into<anyhow::Error>) -> CatalogError {
+    CatalogError::backend("native head repository", e)
+}
+fn read_head(path: &Path) -> CatalogResult<Option<PublishedHead>> {
+    let file = match OpenOptions::new()
+        .read(true)
+        .custom_flags(nix::libc::O_NOFOLLOW | nix::libc::O_NONBLOCK)
+        .open(path)
+    {
+        Ok(file) => file,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(e) => return Err(error(e)),
+    };
+    if !file.metadata().map_err(error)?.is_file() {
+        return Err(invalid("head is not a regular file"));
+    }
+    let mut bytes = Vec::new();
+    file.take(4 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(error)?;
+    if bytes.len() > 4 * 1024 * 1024 {
+        return Err(invalid("native head too large"));
+    }
+    let head: PublishedHead = serde_json::from_slice(&bytes).map_err(error)?;
+    head.validate()?;
+    Ok(Some(head))
+}
+fn write_head(path: &Path, head: &PublishedHead) -> CatalogResult<()> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| invalid("missing head parent"))?;
+    let mut temp = tempfile::NamedTempFile::new_in(parent).map_err(error)?;
+    temp.write_all(&serde_json::to_vec(head).map_err(error)?)
+        .map_err(error)?;
+    temp.as_file().sync_all().map_err(error)?;
+    temp.persist(path).map_err(|e| error(e.error))?;
+    File::open(parent).and_then(|f| f.sync_all()).map_err(error)
+}
diff --git a/storage/volume-core/src/journal.rs b/storage/volume-core/src/journal.rs
new file mode 100644
index 0000000..59fb688
--- /dev/null
+++ b/storage/volume-core/src/journal.rs
@@ -0,0 +1,226 @@
+//! Durable native-side operation identity. This is a side-effect journal, not
+//! a writer lease: authorization must already have been checked by its caller.
+use crate::{
+    catalog::{CatalogError, CatalogResult},
+    is_valid_volume_component,
+};
+use nix::fcntl::{Flock, FlockArg};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{Read, Write},
+    os::unix::fs::OpenOptionsExt,
+    path::{Path, PathBuf},
+};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct NativeIntent {
+    pub operation_id: String,
+    pub input_digest: String,
+    pub volume_id: String,
+    pub repository_id: String,
+    pub kind: String,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub enum NativeOperationState {
+    Intent,
+    Started,
+    NeedsRecovery,
+    Completed,
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct NativeOperation {
+    pub version: u32,
+    pub intent: NativeIntent,
+    pub state: NativeOperationState,
+    pub receipt: Option<Value>,
+    #[serde(default)]
+    pub checkpoints: std::collections::BTreeMap<String, Value>,
+}
+
+/// The filesystem lock is held across the native operation. Never use a lease
+/// timeout to steal it from a still-running formatter or daemon operation.
+pub struct LockedOperation {
+    path: PathBuf,
+    record: NativeOperation,
+    _lock: Flock<File>,
+}
+
+fn invalid(reason: impl Into<String>) -> CatalogError {
+    CatalogError::InvalidRequest {
+        reason: reason.into(),
+    }
+}
+fn io(error: std::io::Error) -> CatalogError {
+    CatalogError::backend("native operation journal", error)
+}
+
+impl LockedOperation {
+    pub fn open(root: &Path, intent: NativeIntent) -> CatalogResult<Self> {
+        if !root.is_absolute()
+            || !is_valid_volume_component(&intent.operation_id)
+            || !is_valid_volume_component(&intent.volume_id)
+            || intent.repository_id.is_empty()
+            || intent.kind.is_empty()
+            || intent.input_digest.len() != 64
+            || !intent.input_digest.bytes().all(|v| v.is_ascii_hexdigit())
+        {
+            return Err(invalid("invalid native operation identity"));
+        }
+        fs::create_dir_all(root).map_err(io)?;
+        let root = root.canonicalize().map_err(io)?;
+        let lock_path = root.join(format!("{}.lock", intent.operation_id));
+        let file = OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .read(true)
+            .write(true)
+            .mode(0o600)
+            .custom_flags(nix::libc::O_NOFOLLOW)
+            .open(lock_path)
+            .map_err(io)?;
+        if !file.metadata().map_err(io)?.is_file() {
+            return Err(invalid("native operation lock is not a regular file"));
+        }
+        let lock = Flock::lock(file, FlockArg::LockExclusiveNonblock).map_err(|(_, error)| {
+            CatalogError::backend("native operation is already executing", error)
+        })?;
+        let path = root.join(format!("{}.json", intent.operation_id));
+        let existing = match OpenOptions::new()
+            .read(true)
+            .custom_flags(nix::libc::O_NOFOLLOW | nix::libc::O_NONBLOCK)
+            .open(&path)
+        {
+            Ok(file) => {
+                if !file.metadata().map_err(io)?.is_file() {
+                    return Err(invalid("native operation record is not a regular file"));
+                }
+                let mut bytes = Vec::new();
+                file.take(4 * 1024 * 1024 + 1)
+                    .read_to_end(&mut bytes)
+                    .map_err(io)?;
+                if bytes.len() > 4 * 1024 * 1024 {
+                    return Err(invalid("oversized native operation record"));
+                }
+                let existing: NativeOperation = serde_json::from_slice(&bytes)
+                    .map_err(|e| CatalogError::backend("decode native operation", e))?;
+                if existing.version != 1 || existing.intent != intent {
+                    return Err(invalid("native operation identity conflict"));
+                }
+                if existing.state == NativeOperationState::Completed && existing.receipt.is_none() {
+                    return Err(invalid("completed native operation lacks receipt"));
+                }
+                if existing.receipt.as_ref().is_some_and(Value::is_null)
+                    || (existing.state != NativeOperationState::Completed
+                        && existing.receipt.is_some())
+                {
+                    return Err(invalid("native operation receipt does not match state"));
+                }
+                existing
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => NativeOperation {
+                version: 1,
+                intent,
+                state: NativeOperationState::Intent,
+                receipt: None,
+                checkpoints: Default::default(),
+            },
+            Err(error) => return Err(io(error)),
+        };
+        let op = Self {
+            path,
+            record: existing,
+            _lock: lock,
+        };
+        op.persist()?;
+        Ok(op)
+    }
+    pub fn record(&self) -> &NativeOperation {
+        &self.record
+    }
+    /// Persist immutable evidence before/after a native side effect. Replaying
+    /// a checkpoint cannot replace its original input or captured artifact.
+    pub fn checkpoint(&mut self, name: &str, value: Value) -> CatalogResult<()> {
+        if !is_valid_volume_component(name) || value.is_null() {
+            return Err(invalid("invalid operation checkpoint"));
+        }
+        if let Some(prior) = self.record.checkpoints.get(name) {
+            return if prior == &value {
+                Ok(())
+            } else {
+                Err(invalid("native checkpoint cannot change"))
+            };
+        }
+        if self.record.state == NativeOperationState::Completed {
+            return Err(invalid("completed operation is immutable"));
+        }
+        self.record.checkpoints.insert(name.to_owned(), value);
+        if let Err(error) = self.persist() {
+            self.record.checkpoints.remove(name);
+            return Err(error);
+        }
+        Ok(())
+    }
+    pub fn begin(&mut self) -> CatalogResult<()> {
+        if self.record.state != NativeOperationState::Intent {
+            return Err(invalid(
+                "native side effect already started; inspect the same operation",
+            ));
+        }
+        self.set(NativeOperationState::Started, None)
+    }
+    pub fn mark_unknown(&mut self) -> CatalogResult<()> {
+        if self.record.state != NativeOperationState::Started {
+            return Err(invalid("only a started operation can become unknown"));
+        }
+        self.set(NativeOperationState::NeedsRecovery, None)
+    }
+    pub fn complete(&mut self, receipt: Value) -> CatalogResult<()> {
+        if receipt.is_null() {
+            return Err(invalid("completion requires a native receipt"));
+        }
+        if self.record.state == NativeOperationState::Completed {
+            return if self.record.receipt.as_ref() == Some(&receipt) {
+                Ok(())
+            } else {
+                Err(invalid("completed operation receipt cannot change"))
+            };
+        }
+        if !matches!(
+            self.record.state,
+            NativeOperationState::Started | NativeOperationState::NeedsRecovery
+        ) {
+            return Err(invalid("operation was never dispatched"));
+        }
+        self.set(NativeOperationState::Completed, Some(receipt))
+    }
+    fn set(&mut self, state: NativeOperationState, receipt: Option<Value>) -> CatalogResult<()> {
+        let old = self.record.clone();
+        self.record.state = state;
+        self.record.receipt = receipt;
+        if let Err(error) = self.persist() {
+            self.record = old;
+            return Err(error);
+        }
+        Ok(())
+    }
+    fn persist(&self) -> CatalogResult<()> {
+        let parent = self
+            .path
+            .parent()
+            .ok_or_else(|| invalid("journal parent missing"))?;
+        let bytes = serde_json::to_vec(&self.record)
+            .map_err(|e| CatalogError::backend("serialize native operation", e))?;
+        if bytes.len() > 4 * 1024 * 1024 {
+            return Err(invalid("oversized native operation record"));
+        }
+        let mut temp = tempfile::NamedTempFile::new_in(parent).map_err(io)?;
+        temp.write_all(&bytes).map_err(io)?;
+        temp.as_file().sync_all().map_err(io)?;
+        temp.persist(&self.path).map_err(|e| io(e.error))?;
+        File::open(parent).and_then(|f| f.sync_all()).map_err(io)
+    }
+}
diff --git a/storage/volume-core/src/layers.rs b/storage/volume-core/src/layers.rs
new file mode 100644
index 0000000..8506b00
--- /dev/null
+++ b/storage/volume-core/src/layers.rs
@@ -0,0 +1,462 @@
+//! Layer publication reused by native snapshots and the CSI volume backend.
+use crate::catalog::{CatalogError as RepositoryError, CatalogResult as RepositoryResult};
+use crate::materialize::write_dense_overlaybd_layer_to_file_blocking;
+use crate::{digest::FileDigest, posix::VolumeLayout, ManagedLayer, OverlaybdLayerRef};
+use overlaybd::{
+    config::load_image_config as load_overlaybd_image_config, dense_export,
+    layer_metadata::read_overlaybd_layer_uuid,
+};
+use std::{
+    fs,
+    os::unix::fs::PermissionsExt,
+    path::{Path, PathBuf},
+};
+use tempfile::NamedTempFile;
+pub struct PosixLayerStore {
+    root: PathBuf,
+}
+impl PosixLayerStore {
+    pub fn new(root: PathBuf) -> Self {
+        Self { root }
+    }
+    pub fn managed_layer_path(&self, digest: &str) -> PathBuf {
+        VolumeLayout::managed_layer_path(&self.root, digest)
+    }
+    pub fn publish_volume_backing(&self, path: &Path) -> RepositoryResult<Vec<OverlaybdLayerRef>> {
+        self.derive_rootfs_layers(path, true, |_| false)
+    }
+    pub fn store_managed_layer(
+        &self,
+        source: &Path,
+        digest: &str,
+        size: u64,
+        uuid: Option<String>,
+    ) -> RepositoryResult<crate::ManagedLayer> {
+        let destination = VolumeLayout::managed_layer_path(&self.root, digest);
+        if destination.exists() {
+            let destination_size = fs::metadata(&destination)
+                .map_err(|error| {
+                    RepositoryError::backend(
+                        format!("read managed layer metadata '{}'", destination.display()),
+                        error,
+                    )
+                })?
+                .len();
+            if destination_size != size {
+                return Err(RepositoryError::Backend {
+                    message: format!(
+                        "managed layer '{}' size mismatch: descriptor says {}, existing file has {}",
+                        digest, size, destination_size
+                    ),
+                    source: None,
+                });
+            }
+            return Ok(crate::ManagedLayer {
+                digest: digest.to_string(),
+                size,
+                uuid,
+            });
+        }
+
+        let Some(parent) = destination.parent() else {
+            return Err(RepositoryError::Backend {
+                message: format!(
+                    "resolve parent dir for managed layer '{}'",
+                    destination.display()
+                ),
+                source: None,
+            });
+        };
+        fs::create_dir_all(parent).map_err(|error| {
+            RepositoryError::backend(
+                format!("create managed layer dir '{}'", parent.display()),
+                error,
+            )
+        })?;
+        // Fast path for expected immutable overlaybd lower layers. This is
+        // safe for layers produced by AgentENV/image-cache/snapshot restack
+        // because they are sealed or content-addressed after publication.
+        hard_link_or_copy_managed_layer(source, &destination, parent)?;
+        sync_dir(parent)?;
+
+        Ok(crate::ManagedLayer {
+            digest: digest.to_string(),
+            size,
+            uuid,
+        })
+    }
+
+    pub fn store_sparse_overlaybd_layer_dense(
+        &self,
+        source: &Path,
+    ) -> RepositoryResult<crate::ManagedLayer> {
+        let destination_parent = VolumeLayout::managed_layers_dir(&self.root);
+        fs::create_dir_all(&destination_parent).map_err(|error| {
+            RepositoryError::backend(
+                format!(
+                    "create managed layer dir '{}'",
+                    destination_parent.display()
+                ),
+                error,
+            )
+        })?;
+
+        let temp = NamedTempFile::new_in(&destination_parent).map_err(|error| {
+            RepositoryError::backend(
+                format!(
+                    "create temp dense managed layer in '{}'",
+                    destination_parent.display()
+                ),
+                error,
+            )
+        })?;
+        let temp_path = temp.path().to_path_buf();
+        let descriptor =
+            write_dense_overlaybd_layer_to_file_blocking(source, &temp_path).map_err(|error| {
+                RepositoryError::backend(
+                    format!("dense-export sparse overlaybd layer '{}'", source.display()),
+                    error,
+                )
+            })?;
+
+        let destination = VolumeLayout::managed_layer_path(&self.root, &descriptor.digest);
+        if destination.exists() {
+            let destination_size = fs::metadata(&destination)
+                .map_err(|error| {
+                    RepositoryError::backend(
+                        format!("read managed layer metadata '{}'", destination.display()),
+                        error,
+                    )
+                })?
+                .len();
+            if destination_size != descriptor.size {
+                return Err(RepositoryError::Backend {
+                    message: format!(
+                        "managed layer '{}' size mismatch: descriptor says {}, existing file has {}",
+                        descriptor.digest, descriptor.size, destination_size
+                    ),
+                    source: None,
+                });
+            }
+            return Ok(crate::ManagedLayer {
+                digest: descriptor.digest,
+                size: descriptor.size,
+                uuid: None,
+            });
+        }
+
+        temp.as_file().sync_all().map_err(|error| {
+            RepositoryError::backend(
+                format!("sync temp managed layer '{}'", temp_path.display()),
+                error,
+            )
+        })?;
+        match temp.persist_noclobber(&destination) {
+            Ok(_) => {}
+            Err(error) if error.error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(error) => {
+                return Err(RepositoryError::backend(
+                    format!(
+                        "persist dense managed layer temp '{}' -> '{}'",
+                        error.file.path().display(),
+                        destination.display()
+                    ),
+                    error.error,
+                ));
+            }
+        }
+
+        Ok(crate::ManagedLayer {
+            digest: descriptor.digest,
+            size: descriptor.size,
+            uuid: None,
+        })
+    }
+
+    pub fn import_managed_layer_with_descriptor(
+        &self,
+        source: &Path,
+        digest: &str,
+        size: u64,
+    ) -> RepositoryResult<crate::ManagedLayer> {
+        let canonical = fs::canonicalize(source).map_err(|error| {
+            RepositoryError::backend(
+                format!("canonicalize managed layer source '{}'", source.display()),
+                error,
+            )
+        })?;
+        let source_size = fs::metadata(&canonical)
+            .map_err(|error| {
+                RepositoryError::backend(
+                    format!(
+                        "read managed layer source metadata '{}'",
+                        canonical.display()
+                    ),
+                    error,
+                )
+            })?
+            .len();
+        if source_size != size {
+            return Err(RepositoryError::Backend {
+                message: format!(
+                    "managed layer descriptor size mismatch for '{}': descriptor says {}, file has {}",
+                    canonical.display(),
+                    size,
+                    source_size
+                ),
+                source: None,
+            });
+        }
+
+        // Descriptor-backed imports intentionally trust internally generated
+        // content digests and only validate the cheap size invariant here.
+        let managed =
+            self.store_managed_layer(&canonical, digest, size, overlaybd_layer_uuid(&canonical))?;
+        Ok(managed)
+    }
+
+    pub fn import_managed_layer_by_hash(
+        &self,
+        source: &Path,
+    ) -> RepositoryResult<crate::ManagedLayer> {
+        let canonical = fs::canonicalize(source).map_err(|error| {
+            RepositoryError::backend(
+                format!("canonicalize managed layer source '{}'", source.display()),
+                error,
+            )
+        })?;
+        let descriptor = FileDigest::describe_blocking(&canonical).map_err(|error| {
+            RepositoryError::backend(
+                format!("describe managed layer source '{}'", canonical.display()),
+                error,
+            )
+        })?;
+        let managed = self.store_managed_layer(
+            &canonical,
+            &descriptor.sha256,
+            descriptor.size,
+            overlaybd_layer_uuid(&canonical),
+        )?;
+        Ok(managed)
+    }
+
+    pub fn import_descriptorless_rootfs_layer(
+        &self,
+        source: &Path,
+    ) -> RepositoryResult<crate::ManagedLayer> {
+        let canonical = fs::canonicalize(source).map_err(|error| {
+            RepositoryError::backend(
+                format!("canonicalize managed layer source '{}'", source.display()),
+                error,
+            )
+        })?;
+        if dense_export::should_dense_export_layer(&canonical) {
+            return self.store_sparse_overlaybd_layer_dense(&canonical);
+        }
+        self.import_managed_layer_by_hash(&canonical)
+    }
+
+    pub fn derive_rootfs_layers(
+        &self,
+        image_config_path: &Path,
+        allow_descriptorless: bool,
+        is_runtime_delta: impl Fn(&Path) -> bool,
+    ) -> RepositoryResult<Vec<OverlaybdLayerRef>> {
+        let image_config = load_overlaybd_image_config(image_config_path).map_err(|error| {
+            RepositoryError::backend(
+                format!(
+                    "load overlaybd image config for rootfs layout '{}'",
+                    image_config_path.display()
+                ),
+                error,
+            )
+        })?;
+
+        let layers = image_config
+            .lowers
+            .into_iter()
+            .enumerate()
+            .map(|(index, layer)| {
+                if !layer.file.is_empty() {
+                    let layer_path = Path::new(&layer.file);
+                    if !layer.digest.is_empty() && layer.size > 0 {
+                        return self
+                            .import_managed_layer_with_descriptor(
+                                layer_path,
+                                &layer.digest,
+                                layer.size,
+                            )
+                            .map(OverlaybdLayerRef::Managed);
+                    }
+                    if allow_descriptorless || is_runtime_delta(layer_path) {
+                        return self
+                            .import_descriptorless_rootfs_layer(layer_path)
+                            .map(OverlaybdLayerRef::Managed);
+                    }
+                    return Err(RepositoryError::Unsupported {
+                        feature: format!(
+                            "local overlaybd lower layer {index} '{}' missing digest/size",
+                            layer_path.display()
+                        ),
+                    });
+                }
+
+                let repo_blob_url = layer
+                    .effective_repo_blob_url(&image_config.repo_blob_url)
+                    .to_string();
+                if !repo_blob_url.is_empty() {
+                    return Ok(OverlaybdLayerRef::External(crate::ExternalLayer {
+                        digest: if !layer.digest.is_empty() {
+                            layer.digest
+                        } else if !layer.target_digest.is_empty() {
+                            layer.target_digest
+                        } else {
+                            format!("external:{index}")
+                        },
+                        repo_blob_url: repo_blob_url.clone(),
+                        size: layer.size,
+                    }));
+                }
+
+                Err(RepositoryError::Unsupported {
+                    feature: format!(
+                        "overlaybd lower layer {index} without local file or repoBlobUrl"
+                    ),
+                })
+            })
+            .collect::<RepositoryResult<Vec<_>>>()?;
+
+        Ok(layers)
+    }
+
+    pub fn derive_memory_layers(
+        &self,
+        mem_image_config_path: &Path,
+    ) -> RepositoryResult<Vec<ManagedLayer>> {
+        let image_config = load_overlaybd_image_config(mem_image_config_path).map_err(|error| {
+            RepositoryError::backend(
+                format!(
+                    "load mem image config for memory layers '{}'",
+                    mem_image_config_path.display()
+                ),
+                error,
+            )
+        })?;
+
+        image_config
+            .lowers
+            .into_iter()
+            .enumerate()
+            .map(|(index, layer)| {
+                if layer.file.is_empty() {
+                    return Err(RepositoryError::Unsupported {
+                        feature: format!("memory layer {index} without local file path"),
+                    });
+                }
+                let layer_path = Path::new(&layer.file);
+                if !layer.digest.is_empty() && layer.size > 0 {
+                    return self.import_managed_layer_with_descriptor(
+                        layer_path,
+                        &layer.digest,
+                        layer.size,
+                    );
+                }
+                self.import_managed_layer_by_hash(layer_path)
+            })
+            .collect()
+    }
+}
+fn overlaybd_layer_uuid(source: &Path) -> Option<String> {
+    read_overlaybd_layer_uuid(source)
+        .ok()
+        .filter(|uuid| !uuid.is_nil())
+        .map(|uuid| uuid.to_string())
+}
+
+fn hard_link_or_copy_managed_layer(
+    source: &Path,
+    destination: &Path,
+    destination_parent: &Path,
+) -> RepositoryResult<()> {
+    match fs::hard_link(source, destination) {
+        Ok(()) => {
+            finalize_hard_linked_file(destination)?;
+            return Ok(());
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+            return Ok(());
+        }
+        Err(_) => {}
+    }
+
+    let temp = NamedTempFile::new_in(destination_parent).map_err(|error| {
+        RepositoryError::backend(
+            format!(
+                "create temp managed layer next to '{}'",
+                destination.display()
+            ),
+            error,
+        )
+    })?;
+    fs::copy(source, temp.path()).map_err(|error| {
+        RepositoryError::backend(
+            format!(
+                "copy managed layer from '{}' to temp '{}'",
+                source.display(),
+                temp.path().display()
+            ),
+            error,
+        )
+    })?;
+    temp.as_file().sync_all().map_err(|error| {
+        RepositoryError::backend(
+            format!("sync temp managed layer '{}'", temp.path().display()),
+            error,
+        )
+    })?;
+    match temp.persist_noclobber(destination) {
+        Ok(_) => Ok(()),
+        Err(error) if error.error.kind() == std::io::ErrorKind::AlreadyExists => Ok(()),
+        Err(error) => Err(RepositoryError::backend(
+            format!(
+                "persist managed layer temp '{}' -> '{}'",
+                error.file.path().display(),
+                destination.display()
+            ),
+            error.error,
+        )),
+    }
+}
+
+fn finalize_hard_linked_file(path: &Path) -> RepositoryResult<()> {
+    chmod_read_only(path)?;
+    fs::File::open(path)
+        .map_err(|error| {
+            RepositoryError::backend(format!("open hard-linked file '{}'", path.display()), error)
+        })?
+        .sync_all()
+        .map_err(|error| {
+            RepositoryError::backend(format!("sync hard-linked file '{}'", path.display()), error)
+        })?;
+    Ok(())
+}
+
+fn sync_dir(path: &Path) -> RepositoryResult<()> {
+    fs::File::open(path)
+        .map_err(|error| RepositoryError::backend(format!("open '{}'", path.display()), error))?
+        .sync_all()
+        .map_err(|error| RepositoryError::backend(format!("sync '{}'", path.display()), error))?;
+    Ok(())
+}
+
+fn chmod_read_only(path: &Path) -> RepositoryResult<()> {
+    let mut permissions = fs::metadata(path)
+        .map_err(|error| {
+            RepositoryError::backend(format!("read metadata of '{}'", path.display()), error)
+        })?
+        .permissions();
+    permissions.set_mode(permissions.mode() & !0o222);
+    fs::set_permissions(path, permissions).map_err(|error| {
+        RepositoryError::backend(format!("chmod '{}' to read-only", path.display()), error)
+    })
+}
